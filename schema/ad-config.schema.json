{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Remote ad config",
  "description": "Konfigurasi iklan remote per aplikasi (v1/<package>.json).",
  "type": "object",
  "required": ["schema", "ads"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "Versi skema. Harus 1.",
      "const": 1
    },
    "ads": {
      "description": "Pengaturan semua format iklan.",
      "type": "object",
      "required": ["appOpen", "banner", "interstitial", "native"],
      "additionalProperties": false,
      "properties": {
        "appOpen": { "$ref": "#/definitions/format" },
        "banner": { "$ref": "#/definitions/format" },
        "interstitial": {
          "description": "Iklan interstitial (layar penuh), muncul setiap N tap.",
          "type": "object",
          "required": ["enabled", "unitId", "everyNTaps", "cooldownSec"],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "description": "true = iklan tampil, false = dimatikan.",
              "type": "boolean"
            },
            "unitId": { "$ref": "#/definitions/unitId" },
            "everyNTaps": {
              "description": "Tampilkan iklan setiap N tap. Rentang 3 sampai 20.",
              "type": "integer",
              "minimum": 3,
              "maximum": 20
            },
            "cooldownSec": {
              "description": "Jeda minimal antar iklan dalam detik. Rentang 0 sampai 600.",
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          }
        },
        "native": { "$ref": "#/definitions/format" }
      }
    }
  },
  "definitions": {
    "unitId": {
      "description": "Ad unit ID AdMob. Hanya publisher yang diizinkan (test atau milik sendiri), format ca-app-pub-<publisher>/<10 digit>.",
      "type": "string",
      "pattern": "^ca-app-pub-(3940256099942544|5326010034326903)/[0-9]{10}$"
    },
    "format": {
      "description": "Pengaturan satu format iklan.",
      "type": "object",
      "required": ["enabled", "unitId"],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "true = iklan tampil, false = dimatikan.",
          "type": "boolean"
        },
        "unitId": { "$ref": "#/definitions/unitId" }
      }
    }
  }
}
