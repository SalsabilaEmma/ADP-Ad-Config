#!/bin/sh
# Block commit if any v1/*.json is invalid, then refresh meta/index.json.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! python3 scripts/validate.py; then
  echo "" >&2
  echo "COMMIT DIBLOKIR: config tidak valid. Perbaiki error di atas lalu git add + commit lagi." >&2
  exit 1
fi
if ! python3 scripts/update_index.py --staged; then
  echo "" >&2
  echo "COMMIT DIBLOKIR: gagal update meta/index.json." >&2
  exit 1
fi
